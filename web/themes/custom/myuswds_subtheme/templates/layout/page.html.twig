            {% if footer_agency_url %}
            </a>
            {% endif %}

          </div>

          {% if not footer_slim %}
            <div class="usa-footer__contact-links">
              {% if facebook or twitter or youtube or rss %}
              <div class="usa-footer__social-links grid-row grid-gap-1">
              {% if facebook %}
                <div class="grid-col-auto">
                <a class="usa-social-link usa-social-link--facebook" href="{{ facebook }}">
                  <img class="usa-social-link__icon" src="{{ uswds_images }}social-icons/facebook25.svg" alt="Facebook">
                </a>
                </div>
              {% endif %}

              {% if twitter %}
                <div class="grid-col-auto">
                <a class="usa-social-link usa-social-link--twitter" href="{{ twitter }}">
                  <img class="usa-social-link__icon" src="{{ uswds_images }}social-icons/xlogo-16.svg" alt="X">
                </a>
                </div>
              {% endif %}

              {% if youtube %}
                  <div class="grid-col-auto">
                <a class="usa-social-link usa-social-link--youtube" href="{{ youtube }}">
                  <img class="usa-social-link__icon" src="{{ uswds_images }}social-icons/youtube15.svg" alt="YouTube">
                </a>
                  </div>
              {% endif %}

              {% if rss %}
                <div class="grid-col-auto">
                <a class="usa-social-link usa-social-link--rss" href="{{ rss }}">
                  <img class="usa-social-link__icon" src="{{ uswds_images }}social-icons/rss_feed25.svg" alt="RSS">
                </a>
                </div>
              {% endif %}
              </div>
              {% endif %}
              {% if contact_center %}
                <h3
                  class="usa-footer__contact-heading">{{ contact_center }}</h3>
              {% endif %}
              <address class="usa-footer__address">
                <div class="usa-footer__contact-info grid-row grid-gap">
                  {% if phone %}
                    <div class="grid-col-auto">
                      <a href="tel:{{ phone }}">{{ phone }}</a>
                    </div>
                  {% endif %}

                  {% if email %}
                    <div class="grid-col-auto">
                      <a href="mailto:{{ email }}">{{ email }}</a>
                    </div>
                  {% endif %}
                </div>
              </address>
            </div>
          {% endif %}

        </div>
        {% endif %}

        {% if page.footer_secondary %}
          <div class="grid-container">
            <div class="grid-row grid-gap">
              <div class="grid-col-fill">
                {{ page.footer_secondary }}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if page.secondary_footer_menu %}
    <div class="usa-footer__secondary-menu-section">
      <div class="grid-container">
        <div class="grid-row grid-gap">
          <div class="grid-col-fill">
            {{ page.secondary_footer_menu }}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</footer>
