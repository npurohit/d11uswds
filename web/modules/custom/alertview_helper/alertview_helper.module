<?php

/**
 * @file
 * Primary module hooks for Alert View Helper module.
 */

/**
 * Implements hook_preprocess_views_view().
 * 
 * Attaches the view-block-navigation library to the specified view.
 * This enables in-block navigation with back button functionality.
 */
function alertview_helper_preprocess_views_view(&$variables) {
  $view = $variables['view'];
  
  // TODO: Replace 'YOUR_VIEW_ID' with your actual view machine name
  // TODO: Replace 'block_1' with your actual display ID if different
  // You can find these at: Structure > Views > [Your View] > Edit
  
  // Example: if ($view->id() == 'news_articles' && $view->current_display == 'block_1') {
  
  if ($view->id() == 'YOUR_VIEW_ID' && $view->current_display == 'block_1') {
    // Attach the library from your theme
    // TODO: Replace 'YOUR_THEME' with your actual theme machine name
    $variables['#attached']['library'][] = 'YOUR_THEME/view-block-navigation';
  }
}
